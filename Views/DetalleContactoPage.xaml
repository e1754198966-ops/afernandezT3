<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandezT3.Views.DetalleContactoPage"
             Title="Detalle del Contacto">

    <!-- ESTILOS EXPLÍCITOS PARA LA VENTANA 2 -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#0E6655" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,15" />
            </Style>

            <Style x:Key="TitleLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#2E4053" />
            </Style>

            <Style x:Key="ValueLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="#117A65" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="ExportButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#117A65" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,20,0,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="5">

            <!-- Imagen ilustrativa -->
            <Image Source="icon.jpg"
       HeightRequest="100"
       WidthRequest="100"
       HorizontalOptions="Center"
       Margin="0,10,0,20"/>
            <Label Text="Resumen de Datos Registrados" Style="{StaticResource HeaderLabelStyle}" />

            <Label Text="Tipo de Documento:" Style="{StaticResource TitleLabelStyle}" />
            <Label x:Name="lblTipoId" Style="{StaticResource ValueLabelStyle}" />

            <Label Text="Número de Identificación:" Style="{StaticResource TitleLabelStyle}" />
            <Label x:Name="lblIdentificacion" Style="{StaticResource ValueLabelStyle}" />

            <Label Text="Nombres Completos:" Style="{StaticResource TitleLabelStyle}" />
            <Label x:Name="lblNombresCompletos" Style="{StaticResource ValueLabelStyle}" />

            <Label Text="Fecha de Nacimiento:" Style="{StaticResource TitleLabelStyle}" />
            <Label x:Name="lblFecha" Style="{StaticResource ValueLabelStyle}" />

            <Label Text="Correo Electrónico:" Style="{StaticResource TitleLabelStyle}" />
            <Label x:Name="lblCorreo" Style="{StaticResource ValueLabelStyle}" />

            <Label Text="Salario Base:" Style="{StaticResource TitleLabelStyle}" />
            <Label x:Name="lblSalario" Style="{StaticResource ValueLabelStyle}" />

            <Border BackgroundColor="#E8F8F5" Padding="15" StrokeShape="RoundRectangle 10" Margin="0,10,0,10">
                <VerticalStackLayout>
                    <Label Text="Aporte Individual al IESS (9.45%):" Style="{StaticResource TitleLabelStyle}" />
                    <Label x:Name="lblIESS" FontSize="18" FontAttributes="Bold" TextColor="#0E6655" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Exportar a Archivo de Texto (.txt)"
                    Style="{StaticResource ExportButtonStyle}"
                    Clicked="OnExportarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>