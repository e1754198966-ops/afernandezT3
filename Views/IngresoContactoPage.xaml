<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandezT3.Views.IngresoContactoPage"
             Title="Registro de Contacto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="5">

            <!-- Imagen ilustrativa -->

            <Image Source="icon.jpg"
       HeightRequest="100"
       WidthRequest="100"
       HorizontalOptions="Center"
       Margin="0,10,0,20"/>

            <Label Text="Tipo de Identificación:" FontAttributes="Bold" />
            <Picker x:Name="pickerTipoId" Title="Seleccione un tipo" SelectedIndex="0">
                <Picker.Items>
                    <x:String>Seleccione un tipo</x:String>
                    <x:String>CI</x:String>
                    <x:String>RUC</x:String>
                    <x:String>Pasaporte</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="Número de Identificación:" FontAttributes="Bold" />
            <Entry x:Name="txtIdentificacion" Placeholder="Ingrese identificación" Keyboard="Default"/>

            <Label Text="Nombres:" FontAttributes="Bold" />
            <Entry x:Name="txtNombres" Placeholder="Ingrese sus nombres" />

            <Label Text="Apellidos:" FontAttributes="Bold" />
            <Entry x:Name="txtApellidos" Placeholder="Ingrese sus apellidos" />

            <Label Text="Fecha de Nacimiento:" FontAttributes="Bold" />
            <DatePicker x:Name="dtpFecha" Format="dd/MM/yyyy" />

            <Label Text="Correo Electrónico:" FontAttributes="Bold" />
            <Entry x:Name="txtCorreo" Placeholder="ejemplo@correo.com" Keyboard="Email" />

            <Label Text="Salario ($):" FontAttributes="Bold" />
            <Entry x:Name="txtSalario" Placeholder="0.00" Keyboard="Numeric" />

            <Button Text="Guardar y Continuar" Clicked="OnGuardarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>